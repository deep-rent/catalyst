{
  "name": "catalyst-run-on-save",
  "displayName": "Catalyst - Run on Save",
  "description": "Run commands automatically on file save",
  "version": "1.0.6",
  "publisher": "deep-rent",
  "author": "deep.rent GmbH",
  "license": "MIT",
  "icon": "assets/icon.png",
  "keywords": [
    "automation",
    "command",
    "execute",
    "extension",
    "on-save",
    "run",
    "save",
    "trigger",
    "vscode"
  ],
  "categories": [
    "Other"
  ],
  "homepage": "https://marketplace.visualstudio.com/items?itemName=deep-rent.catalyst-run-on-save",
  "repository": {
    "type": "git",
    "url": "https://github.com/deep-rent/catalyst.git"
  },
  "bugs": {
    "url": "https://github.com/deep-rent/catalyst/issues"
  },
  "engines": {
    "vscode": ">=1.107.0",
    "node": ">=24.0.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Catalyst",
      "properties": {
        "catalyst-run-on-save.actions": {
          "type": "array",
          "default": [],
          "description": "List of actions to run on file save.",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "A descriptive name for the action."
              },
              "command": {
                "type": [
                  "string",
                  "object"
                ],
                "description": "The command to run. Can be a string or an object with platform-specific commands ('windows', 'macos', 'linux', 'default')."
              },
              "include": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Glob patterns indicating which files trigger the action."
              },
              "exclude": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Glob patterns to exempt specific files from triggering the action."
              },
              "shell": {
                "type": "string",
                "description": "Path to the custom shell executable (e.g., /bin/bash, powershell.exe)."
              }
            },
            "required": [
              "command"
            ]
          }
        },
        "catalyst-run-on-save.showErrorPopups": {
          "type": "boolean",
          "default": true,
          "description": "Show an error message popup when an action fails."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./ && node esbuild.mjs",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src",
    "package": "npx @vscode/vsce package",
    "postversion": "git push && git push origin v$npm_package_version",
    "test": "node ./out/test/runTest.js",
    "vscode:prepublish": "tsc -p ./ && node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch"
  },
  "dependencies": {
    "minimatch": "10.2.x"
  },
  "devDependencies": {
    "@eslint/js": "10.0.x",
    "@types/mocha": "10.x",
    "@types/node": "24.x",
    "@types/vscode": "1.107.x",
    "@vscode/test-electron": "3.0.x",
    "esbuild": "0.28.1",
    "eslint": "10.7.x",
    "eslint-config-prettier": "10.1.x",
    "eslint-plugin-headers": "1.3.x",
    "eslint-plugin-prettier": "5.5.x",
    "eslint-plugin-simple-import-sort": "14.0.x",
    "eslint-plugin-tsdoc": "0.5.x",
    "mocha": "11.7.x",
    "prettier": "3.9.x",
    "typescript": "6.0.x",
    "typescript-eslint": "8.64.x"
  },
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
